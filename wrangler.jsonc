{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solos-mobile-com",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solos-bookings",
      "database_id": "b690ba24-a1f7-41f3-bd69-9c19c42e6b71"
    }
  ]
}
